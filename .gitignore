# Source and small declared contracts belong in Git; runtime identities do not.
__pycache__/
*.py[cod]
.pytest_cache/
.ruff_cache/
*.egg-info/
/build/
/dist/
/htmlcov/
.coverage*
coverage.xml
.venv/
venv/
.idea/
.vscode/
*.swp
*.tmp
*.lock

# Secrets and machine-local execution settings.
.env
.env.*
!.env.example
*.pem
*.key
id_rsa*
id_ed25519*
/configs/local/
/configs/**/*path_mapping*.json
/configs/**/*runtime_paths*.json
/configs/**/*machine_resources*.json

# These trees contain real ledgers, historical identities and frozen inputs.
# Excluding them does NOT authorize deletion. Provision via SHA manifests.
/runs/
/isolated/
/assets/
/artifacts/
/configs/experiments/
/configs/branches/
/configs/branches/*allocations*.json
/configs/branches/*authorization*.json
/configs/**/budget*.json
/configs/**/ledger*.json
/configs/**/state.json
/configs/**/task_ledger.json
/configs/**/authorization_receipt.json
/configs/**/approval_request.json
/configs/**/publication_complete.json

# Weights, data and deployment binaries; C/H/JSON source remains visible.
*.pt
*.pth
*.ckpt
*.onnx
*.npz
*.npy
*.usd
*.usda
*.usdc
*.stl
*.obj
*.so
*.o
*.a
*.dll
*.dylib
*.log
*.jsonl
*.csv
*.tar
*.tar.gz
*.tgz
*.zip
*.7z
*.mp4
*.webm
/deployment_protocol/**/verification.json

# Audited historical pure-C contract generator is still a portable test input.
!/isolated/
/isolated/*
!/isolated/2026_11_05__motion_interface_research/
/isolated/2026_11_05__motion_interface_research/*
!/isolated/2026_11_05__motion_interface_research/build_centered_design.py
